{
    "Main": {
        "prefix": "main",
        "body": [
            "using System;",
            "",
            "class Program",
            "{",
            "\tstatic void Main(string[] args)",
            "\t{",
            "\t\t$0",
            "\t}",
            "}"
        ],
        "description": "Main method"
    },

    "Class": {
        "prefix": "class",
        "body": [
            "public class ${1:ClassName}",
            "{",
            "\t$0",
            "}"
        ],
        "description": "Class definition"
    },

    "Struct": {
        "prefix": "struct",
        "body": [
            "public struct ${1:StructName}",
            "{",
            "\t$0",
            "}"
        ],
        "description": "Struct definition"
    },

    "Interface": {
        "prefix": "interface",
        "body": [
            "public interface ${1:IInterface}",
            "{",
            "\t$0",
            "}"
        ],
        "description": "Interface definition"
    },

    "Enum": {
        "prefix": "enum",
        "body": [
            "public enum ${1:EnumName}",
            "{",
            "\t${2:Value1},",
            "\t${3:Value2}",
            "}"
        ],
        "description": "Enum"
    },

    "Record": {
        "prefix": "record",
        "body": [
            "public record ${1:Person}(string Name, int Age);"
        ],
        "description": "Record"
    },

    "Method": {
        "prefix": "func",
        "body": [
            "public ${1:void} ${2:MethodName}(${3})",
            "{",
            "\t$0",
            "}"
        ],
        "description": "Method"
    },

    "Static Method": {
        "prefix": "static",
        "body": [
            "public static ${1:void} ${2:MethodName}(${3})",
            "{",
            "\t$0",
            "}"
        ],
        "description": "Static method"
    },

    "Property": {
        "prefix": "prop",
        "body": [
            "public ${1:string} ${2:Name} { get; set; }"
        ],
        "description": "Auto property"
    },

    "Readonly Property": {
        "prefix": "propr",
        "body": [
            "public ${1:string} ${2:Name} { get; }"
        ],
        "description": "Readonly property"
    },

    "Constructor": {
        "prefix": "ctor",
        "body": [
            "public ${1:ClassName}(${2})",
            "{",
            "\t$0",
            "}"
        ],
        "description": "Constructor"
    },

    "If": {
        "prefix": "if",
        "body": [
            "if (${1:condition})",
            "{",
            "\t$0",
            "}"
        ],
        "description": "If statement"
    },

    "If Else": {
        "prefix": "ife",
        "body": [
            "if (${1:condition})",
            "{",
            "\t$2",
            "}",
            "else",
            "{",
            "\t$0",
            "}"
        ],
        "description": "If else"
    },

    "Switch": {
        "prefix": "switch",
        "body": [
            "switch (${1:value})",
            "{",
            "\tcase ${2:value}:",
            "\t\t$3",
            "\t\tbreak;",
            "",
            "\tdefault:",
            "\t\tbreak;",
            "}"
        ],
        "description": "Switch statement"
    },

    "Switch Expression": {
        "prefix": "switche",
        "body": [
            "var ${1:result} = ${2:value} switch",
            "{",
            "\t${3:case1} => ${4:result1},",
            "\t_ => ${5:default}",
            "};"
        ],
        "description": "Switch expression"
    },

    "For": {
        "prefix": "for",
        "body": [
            "for (int ${1:i} = 0; ${1:i} < ${2:n}; ${1:i}++)",
            "{",
            "\t$0",
            "}"
        ],
        "description": "For loop"
    },

    "Foreach": {
        "prefix": "foreach",
        "body": [
            "foreach (var ${1:item} in ${2:collection})",
            "{",
            "\t$0",
            "}"
        ],
        "description": "Foreach loop"
    },

    "While": {
        "prefix": "while",
        "body": [
            "while (${1:condition})",
            "{",
            "\t$0",
            "}"
        ],
        "description": "While loop"
    },

    "Do While": {
        "prefix": "dowhile",
        "body": [
            "do",
            "{",
            "\t$0",
            "} while (${1:condition});"
        ],
        "description": "Do while"
    },

    "Try Catch": {
        "prefix": "try",
        "body": [
            "try",
            "{",
            "\t$1",
            "}",
            "catch (Exception ex)",
            "{",
            "\tConsole.WriteLine(ex.Message);",
            "}"
        ],
        "description": "Try catch"
    },

    "Try Catch Finally": {
        "prefix": "tryf",
        "body": [
            "try",
            "{",
            "\t$1",
            "}",
            "catch (Exception ex)",
            "{",
            "\tConsole.WriteLine(ex.Message);",
            "}",
            "finally",
            "{",
            "\t$0",
            "}"
        ],
        "description": "Try catch finally"
    },

    "Using": {
        "prefix": "using",
        "body": [
            "using var ${1:resource} = ${2:new Resource()};"
        ],
        "description": "Using declaration"
    },

    "Console WriteLine": {
        "prefix": "cw",
        "body": [
            "Console.WriteLine(${1});"
        ],
        "description": "Console.WriteLine"
    },

    "Console ReadLine": {
        "prefix": "cr",
        "body": [
            "string? ${1:input} = Console.ReadLine();"
        ],
        "description": "Console.ReadLine"
    },

    "Parse Int": {
        "prefix": "parse",
        "body": [
            "int ${1:value} = int.Parse(${2:text});"
        ],
        "description": "Parse int"
    },

    "TryParse Int": {
        "prefix": "tryparse",
        "body": [
            "if (int.TryParse(${1:text}, out int ${2:value}))",
            "{",
            "\t$0",
            "}"
        ],
        "description": "TryParse int"
    },

    "List": {
        "prefix": "list",
        "body": [
            "var ${1:list} = new List<${2:int}>();"
        ],
        "description": "Generic List"
    },

    "Dictionary": {
        "prefix": "dict",
        "body": [
            "var ${1:dict} = new Dictionary<${2:string}, ${3:int}>();"
        ],
        "description": "Dictionary"
    },

    "Lambda": {
        "prefix": "lambda",
        "body": [
            "${1:x} => ${2:expression}"
        ],
        "description": "Lambda expression"
    },

    "LINQ Where": {
        "prefix": "where",
        "body": [
            "var ${1:result} = ${2:collection}.Where(${3:x} => ${4:true});"
        ],
        "description": "LINQ Where"
    },

    "LINQ Select": {
        "prefix": "select",
        "body": [
            "var ${1:result} = ${2:collection}.Select(${3:x} => ${4:x});"
        ],
        "description": "LINQ Select"
    },

    "Task": {
        "prefix": "task",
        "body": [
            "public async Task ${1:MethodName}()",
            "{",
            "\t$0",
            "}"
        ],
        "description": "Async Task"
    },

    "Task<T>": {
        "prefix": "taskt",
        "body": [
            "public async Task<${1:int}> ${2:MethodName}()",
            "{",
            "\t$0",
            "}"
        ],
        "description": "Async Task<T>"
    },

    "Await": {
        "prefix": "await",
        "body": [
            "await ${1:Task};"
        ],
        "description": "Await"
    },

    "Namespace": {
        "prefix": "namespace",
        "body": [
            "namespace ${1:MyNamespace};"
        ],
        "description": "File-scoped namespace"
    },

    "Region": {
        "prefix": "region",
        "body": [
            "#region ${1:Name}",
            "$0",
            "#endregion"
        ],
        "description": "Region"
    },

    "Constant": {
        "prefix": "const",
        "body": [
            "public const ${1:int} ${2:Name} = ${3:0};"
        ],
        "description": "Constant"
    },

    "Readonly Field": {
        "prefix": "readonly",
        "body": [
            "private readonly ${1:int} ${2:_value};"
        ],
        "description": "Readonly field"
    },

    "Field": {
        "prefix": "field",
        "body": [
            "private ${1:int} ${2:_value};"
        ],
        "description": "Field"
    },

    "TODO": {
        "prefix": "todo",
        "body": [
            "// TODO(${1:name}): ${2:description}"
        ],
        "description": "TODO comment"
    }
}
