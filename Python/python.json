{
	"Open file for reading": {
		"prefix": "readfile",
		"body": [
			"with open($1) as f:",
			"\ttext = f.read()"
		],
		"description": "Open file for reading in a with statement"
	},
	"Open file for writing": {
		"prefix": "writefile",
		"body": [
			"with open($1, w) as f:",
			"\tf.write($2)"
		],
		"description": "Open file for writing using a with statement"
	},
	"Encoding statement": {
		"prefix": "cod",
		"body": "# -*- coding: utf-8 -*-",
		"description": "File encoding statement"
	},
	"File header comment": {
		"prefix": "fileheader",
		"body": [
			"# -*- coding: utf-8 -*-",
			"#",
			"#  $TM_FILENAME",
			"#  ${2:project}",
			"#",
			"#  Created by André Berg on $CURRENT_YEAR-$CURRENT_MONTH-$CURRENT_DATE.",
			"#  Copyright $CURRENT_YEAR Iris VFX. All rights reserved.",
			"#",
			"#  andre@irisvfx.com",
			"#",
			"# pylint: disable-msg=F0401"
		]
	},
	"Abstract method": {
		"prefix": "abstractmethod",
		"body": [
			"def ${1:name}(self):",
			"\traise NotImplementedError(\"This method is abstract. To provide a concrete implementation override this method in a subclass.\")"
		],
		"description": "Abstract method body"
	},
	"Print function variable": {
		"prefix": "pvar",
		"body": [
			"print('${1:func}: ${2:var} = {}'.format($2))"
		],
		"description": "Print a function local variable"
	},
	"Main entry point": {
		"prefix": "main",
		"body": [
			"def ${1:main()}:",
			"\t$0",
			"",
			"",
			"if __name__ == '__main__':",
			"\t${1:main()}"
		],
		"description": "Call entry point function if this script is run directly"
	},
	"New class with init": {
		"prefix": "class1",
		"body": [
			"class ${1:name}${2:(object)}:",
			"\tdef __init__(self, ${3:var}):",
			"\t\tself.${3:var} = ${3:var}",
			"\tdef __str__(self):",
			"\t\treturn '${1:name}@{:#x}: {}'.format(id(self), self.${3:var})"
		],
		"description": "Simple class skeleton with init and str magic methods"
	},
	"New class with init and docstring": {
		"prefix": "class2",
		"body": [
			"class ${1:name}${2:(object)}:",
			"\t\"\"\" ${3:docstring}",
			"\t\"\"\"",
			"\tdef __init__(self, ${4:var}):",
			"\t\tself.${4:var} = ${4:var}",
			"\tdef __str__(self):",
			"\t\treturn '${1:name}@{:#x}: {}'.format(id(self), self.${4:var})"
		],
		"description": "Class definition with doctsring"
	},
	"Function decorator": {
		"prefix": "decor",
		"body": [
			"def ${1:name}(fn):",
			"\tdef ${1:name}_wrapper(*args, **kwargs):",
			"\t\tprint('{}: args={} kwargs={}'.format(fn.__name__, args, kwargs))",
			"\t\treturn fn(*args, **kwargs)",
			"\treturn ${1:name}_wrapper"
		],
		"description": "Function decorator"
	},
	"Decorated property with encapsulation": {
		"prefix": "eprop",
		"body": [
			"@property",
			"def ${1:name}(self):",
			"\treturn self.__${1:name}",
			"@${1:name}.setter",
			"def ${1:name}(self, value):",
			"\tself.__${1:name} = value",
			"@${1:name}.deleter",
			"def ${1:name}(self, value):",
			"\tdel self.__${1:name}"
		],
		"description": "Encapsulated property getter, setter and deleter"
	},
	"Decorated property": {
		"prefix": "prop1",
		"body": [
			"@property",
			"def ${1:name}(self):",
			"\treturn self.${1:name}",
			"@${1:name}.setter",
			"def ${1:name}(self, value):",
			"\tself.${1:name} = value",
			"@${1:name}.deleter",
			"def ${1:name}(self, value):",
			"\tdel self.${1:name}"
		],
		"description": "Property getter, setter and deleter"
	},
	"Decorated property (without deleter)": {
		"prefix": "prop2",
		"body": [
			"@property",
			"def ${1:name}(self):",
			"\treturn self.${1:name}",
			"@${1:name}.setter",
			"def ${1:name}(self, value):",
			"\tself.${1:name} = value"
		],
		"description": "Property getter and setter"
	},
	"Try / Except": {
		"prefix": "try",
		"body": [
			"try:",
			"\t$1",
			"except Exception as e:",
			"\tprint(f\"Error: {e}\")"
		],
		"description": "Basic try/except block"
	},
	"Try / Except / Finally": {
		"prefix": "tryf",
		"body": [
			"try:",
			"\t$1",
			"except Exception as e:",
			"\tprint(f\"Error: {e}\")",
			"finally:",
			"\t$2"
		],
		"description": "Try/except/finally block"
	},
	"If Statement": {
		"prefix": "if",
		"body": [
			"if ${1:condition}:",
			"\t$0"
		],
		"description": "If statement"
	},
	"If Else": {
		"prefix": "ife",
		"body": [
			"if ${1:condition}:",
			"\t$2",
			"else:",
			"\t$0"
		],
		"description": "If/Else statement"
	},
	"If Elif Else": {
		"prefix": "ifel",
		"body": [
			"if ${1:condition}:",
			"\t$2",
			"elif ${3:condition}:",
			"\t$4",
			"else:",
			"\t$0"
		],
		"description": "If/Elif/Else statement"
	},
	"For Loop": {
		"prefix": "for",
		"body": [
			"for ${1:item} in ${2:iterable}:",
			"\t$0"
		],
		"description": "For loop"
	},
	"For with Enumerate": {
		"prefix": "fore",
		"body": [
			"for ${1:index}, ${2:item} in enumerate(${3:iterable}):",
			"\t$0"
		],
		"description": "Enumerate loop"
	},
	"While Loop": {
		"prefix": "while",
		"body": [
			"while ${1:condition}:",
			"\t$0"
		],
		"description": "While loop"
	},
	"Function": {
		"prefix": "def",
		"body": [
			"def ${1:function_name}(${2:args}):",
			"\t\"\"\"${3:Description}\"\"\"",
			"\t$0"
		],
		"description": "Function definition"
	},
	"Lambda": {
		"prefix": "lam",
		"body": [
			"${1:name} = lambda ${2:x}: ${3:x}"
		],
		"description": "Lambda function"
	},
	"List Comprehension": {
		"prefix": "listcomp",
		"body": [
			"[${1:expr} for ${2:item} in ${3:iterable}]"
		],
		"description": "List comprehension"
	},
	"Dictionary Comprehension": {
		"prefix": "dictcomp",
		"body": [
			"{${1:key}: ${2:value} for ${3:item} in ${4:iterable}}"
		],
		"description": "Dictionary comprehension"
	},
	"With Open": {
		"prefix": "with",
		"body": [
			"with ${1:expression} as ${2:obj}:",
			"\t$0"
		],
		"description": "With statement"
	},
	"Import": {
		"prefix": "imp",
		"body": [
			"import ${1:module}"
		],
		"description": "Import module"
	},
	"Import As": {
		"prefix": "impa",
		"body": [
			"import ${1:module} as ${2:alias}"
		],
		"description": "Import with alias"
	},
	"From Import": {
		"prefix": "from",
		"body": [
			"from ${1:module} import ${2:name}"
		],
		"description": "From import"
	},
	"Print": {
		"prefix": "print",
		"body": [
			"print(${1:value})"
		],
		"description": "Print statement"
	},
	"Formatted Print": {
		"prefix": "fprint",
		"body": [
			"print(f\"${1:variable}={${1:variable}}\")"
		],
		"description": "Formatted print"
	},
	"Return": {
		"prefix": "ret",
		"body": [
			"return ${1:value}"
		],
		"description": "Return statement"
	},
	"Assert": {
		"prefix": "assert",
		"body": [
			"assert ${1:condition}, \"${2:message}\""
		],
		"description": "Assert statement"
	},
	"Logging": {
		"prefix": "log",
		"body": [
			"import logging",
			"",
			"logging.basicConfig(level=logging.INFO)",
			"logger = logging.getLogger(__name__)",
			"",
			"logger.info(${1:message})"
		],
		"description": "Basic logging"
	},
	"Dataclass": {
		"prefix": "dataclass",
		"body": [
			"from dataclasses import dataclass",
			"",
			"@dataclass",
			"class ${1:ClassName}:",
			"\t${2:field}: ${3:str}"
		],
		"description": "Dataclass"
	},
	"Main Guard": {
		"prefix": "ifmain",
		"body": [
			"if __name__ == \"__main__\":",
			"\t$0"
		],
		"description": "Main entry point"
	},
	"Type Hint Function": {
		"prefix": "deft",
		"body": [
			"def ${1:name}(${2:param}: ${3:str}) -> ${4:None}:",
			"\t$0"
		],
		"description": "Typed function"
	},
	"Class": {
		"prefix": "class",
		"body": [
			"class ${1:ClassName}:",
			"\tdef __init__(self):",
			"\t\t$0"
		],
		"description": "Simple class"
	}
}